{
  "expo": {
    "name": "Çiftliğim",
    "slug": "ciftligim",
    "version": "0.5.1",
    "scheme": "ciftligim",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.efekoc.ciftligim"
    },
    "android": {
      "package": "com.efekoc.ciftligim",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#131315",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Küpe numarasını okutmak için kamera kullanılır."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Haritada tarlalarına göre nerede olduğunu göstermek için konum kullanılır."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131315",
          "image": "./assets/splash-logo.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "./plugins/withNoDocumentScanner"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e56e51c7-8140-4cda-b1de-e779076a3be7"
      }
    },
    "owner": "ahmetefekoc",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e56e51c7-8140-4cda-b1de-e779076a3be7",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
